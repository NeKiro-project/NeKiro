{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.nekiro.dev/public-agent-share/v1",
  "title": "NeKiro Public Agent Share v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "publicAgentId", "publicUrl", "registeredAt", "availability", "releases"],
  "properties": {
    "schemaVersion": { "const": "1" },
    "publicAgentId": { "$ref": "#/$defs/publicAgentId" },
    "publicUrl": { "type": "string", "format": "uri", "minLength": 1, "maxLength": 2048 },
    "registeredAt": { "$ref": "https://schemas.nekiro.dev/common/v1#/$defs/dateTime" },
    "availability": { "enum": ["installable", "not_installable"] },
    "releases": {
      "type": "array",
      "maxItems": 100,
      "items": { "$ref": "#/$defs/release" }
    }
  },
  "allOf": [
    {
      "if": { "properties": { "availability": { "const": "installable" } }, "required": ["availability"] },
      "then": { "properties": { "releases": { "minItems": 1 } } },
      "else": { "properties": { "releases": { "maxItems": 0 } } }
    }
  ],
  "$defs": {
    "publicAgentId": {
      "type": "string",
      "pattern": "^agt_[0-9a-f]{32}$"
    },
    "owner": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "displayName"],
      "properties": {
        "id": { "$ref": "https://schemas.nekiro.dev/common/v1#/$defs/ownerId" },
        "displayName": { "type": "string", "minLength": 1, "maxLength": 120, "pattern": "\\S" }
      }
    },
    "permission": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "description"],
      "properties": {
        "id": { "$ref": "https://schemas.nekiro.dev/common/v1#/$defs/permissionId" },
        "description": { "type": "string", "minLength": 1, "maxLength": 1000, "pattern": "\\S" }
      }
    },
    "skill": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "description", "inputSchema", "outputSchema", "requiredPermissions"],
      "properties": {
        "id": { "$ref": "https://schemas.nekiro.dev/common/v1#/$defs/capabilityId" },
        "name": { "type": "string", "minLength": 1, "maxLength": 120, "pattern": "\\S" },
        "description": { "type": "string", "minLength": 1, "maxLength": 2000, "pattern": "\\S" },
        "inputSchema": { "type": "object" },
        "outputSchema": { "type": "object" },
        "requiredPermissions": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "https://schemas.nekiro.dev/common/v1#/$defs/permissionId" }
        }
      }
    },
    "limits": {
      "type": "object",
      "additionalProperties": false,
      "required": ["timeoutMs", "maxInputBytes", "maxOutputBytes", "streaming"],
      "properties": {
        "timeoutMs": { "type": "integer", "minimum": 1, "maximum": 600000 },
        "maxInputBytes": { "type": "integer", "minimum": 1 },
        "maxOutputBytes": { "type": "integer", "minimum": 1 },
        "streaming": { "type": "boolean" }
      }
    },
    "release": {
      "type": "object",
      "additionalProperties": false,
      "required": ["releaseId", "agentId", "name", "description", "owner", "agentCardVersion", "cardDigest", "publishedAt", "authenticationType", "skills", "permissions", "limits"],
      "properties": {
        "releaseId": { "$ref": "https://schemas.nekiro.dev/common/v1#/$defs/safeIdentifier" },
        "agentId": { "$ref": "https://schemas.nekiro.dev/common/v1#/$defs/agentId" },
        "name": { "type": "string", "minLength": 1, "maxLength": 120, "pattern": "\\S" },
        "description": { "type": "string", "minLength": 1, "maxLength": 4000, "pattern": "\\S" },
        "owner": { "$ref": "#/$defs/owner" },
        "agentCardVersion": { "$ref": "https://schemas.nekiro.dev/common/v1#/$defs/semver" },
        "cardDigest": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "publishedAt": { "$ref": "https://schemas.nekiro.dev/common/v1#/$defs/dateTime" },
        "authenticationType": { "enum": ["none", "api_key", "http_bearer", "oauth2_client_credentials", "mutual_tls"] },
        "skills": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/skill" } },
        "permissions": { "type": "array", "items": { "$ref": "#/$defs/permission" } },
        "limits": { "$ref": "#/$defs/limits" }
      }
    }
  }
}
