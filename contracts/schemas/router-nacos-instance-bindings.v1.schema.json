{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.nekiro.dev/router-nacos-instance-bindings/v1",
  "title": "NeKiro Router Nacos Instance Bindings v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "revision", "targets"],
  "properties": {
    "schemaVersion": { "const": "1" },
    "revision": { "$ref": "#/$defs/identifier" },
    "targets": { "type": "array", "maxItems": 1024, "items": { "$ref": "#/$defs/target" } }
  },
  "$defs": {
    "identifier": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$" },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": ["agentId", "agentCardVersion", "releaseId", "cardDigest", "canonicalEndpoint", "audience", "serviceName", "groupName", "clusterName"],
      "properties": {
        "agentId": { "$ref": "#/$defs/identifier" },
        "agentCardVersion": { "type": "string", "minLength": 1, "maxLength": 128 },
        "releaseId": { "$ref": "#/$defs/identifier" },
        "cardDigest": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "canonicalEndpoint": { "type": "string", "format": "uri", "pattern": "^https?://", "maxLength": 2048 },
        "audience": { "type": "string", "format": "uri", "pattern": "^https?://", "maxLength": 2048 },
        "serviceName": { "$ref": "#/$defs/identifier" },
        "groupName": { "$ref": "#/$defs/identifier" },
        "clusterName": { "$ref": "#/$defs/identifier" }
      }
    }
  }
}
